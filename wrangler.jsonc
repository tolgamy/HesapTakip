{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hesaptakip",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["0 7 * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karttakip-db",
      "database_id": "09d5bd29-78c0-48ce-89af-1fb5eadaa73e",
      "migrations_dir": "migrations"
    }
  ]
}
