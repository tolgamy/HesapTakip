{
  "name": "karttakip-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kredi kartı ekstre ve ödeme takip uygulaması — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply karttakip-db --local",
    "db:remote": "wrangler d1 migrations apply karttakip-db --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.44.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0"
  }
}
